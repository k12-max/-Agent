# OpenAI 兼容接口（OpenAI / DeepSeek / 通义百炼 / Ollama 等均可）
# 👉 操作：把本文件复制为 .env（不要直接修改本文件），在 .env 里填真实密钥
#    Windows PowerShell:  copy .env.example .env
#    macOS/Linux:         cp .env.example .env
#
# ⚠️ 重要：OPENAI_BASE_URL 必须与 Key 所属服务商匹配，否则会超时或 401：
#    - OpenAI 官方:        https://api.openai.com/v1
#    - DeepSeek:           https://api.deepseek.com
#    - 阿里云百炼(国内):    https://dashscope.aliyuncs.com/compatible-mode/v1
#    - 阿里云百炼(国际):    https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#    - Ollama 本地:        http://localhost:11434/v1
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型建议：
#   qwen-plus          阿里云主力，实测 0.3s 响应、JSON 稳定（推荐）
#   deepseek-v4-flash  快，但百炼高峰期可能间歇性超时/输出损坏
#   ⚠️ 不要用 deepseek-r1-distill-qwen-7b：实测正文恒为空（内容全在思考区）
OPENAI_MODEL=qwen-plus

# 可选：单次请求超时秒数（推理模型较慢可调大），默认 60
# OPENAI_TIMEOUT=60
# 可选：业务层重试次数，默认 3
# OPENAI_MAX_RETRIES=3
